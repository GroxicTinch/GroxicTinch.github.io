{
	"name": "groxictinch.github.io",
	"private": true,
	"version": "0.0.1",
	"homepage": "https://groxictinch.github.io",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"deploy": "npm run build && echo. > build/.nojekyll && gh-pages -d build --dotfiles"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/postcss": "^4.3.0",
		"autoprefixer": "^10.4.14",
		"gh-pages": "^6.3.0",
		"postcss": "^8.5.15",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"skinview3d": "^3.4.2",
		"three": "^0.184.0"
	}
}
